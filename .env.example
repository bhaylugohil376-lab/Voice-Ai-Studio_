# VoiceAI environment template — placeholders only

NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
